## Frontend environment variables
#
# Backend refactor note:
# When endpoints are moved from `/api/*` to `/api/player/*`,
# update `VITE_API_BASE` to point to the new prefix.
#
# Use this when your backend is exposed via ngrok (or any public URL).
#
# Example:
# VITE_API_BASE="https://your-tunnel.ngrok-free.dev"
#
# After refactor:
# VITE_API_BASE="https://your-tunnel.ngrok-free.dev/api/player"
#
VITE_API_BASE=""

# Discord Activity (Embedded App SDK)
# Create an app in Discord Dev Portal and put its Client ID here.
VITE_DISCORD_CLIENT_ID=""

